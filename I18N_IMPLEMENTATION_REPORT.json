  "integration_instructions": [
    "1. The translation system automatically initializes when App.jsx loads",
    "2. Users can switch languages using the LanguageSwitcher component in the navbar",
    "3. Language preference is saved in localStorage and persists across reloads",
    "4. To add new translations:",
    "   a. Add key to frontend/src/utils/translator/languages/en.json",
    "   b. Add translations to other language files (hi.json, mr.json, etc.)",
    "   c. Add data-translate='key' attribute to JSX elements",
    "5. Enable debug mode: window.I18N_DEBUG = true (in browser console)"
  ],
  "verification_checks": [
    "1. Open browser console and set: window.I18N_DEBUG = true",
    "2. Reload page and check for [I18N] initialization message",
    "3. Switch language using LanguageSwitcher dropdown",
    "4. Verify all text updates instantly",
    "5. Check console for missing translation keys (if any)",
    "6. Verify safe words (AQI, PM2.5, etc.) remain unchanged",
    "7. Verify 'Delhi Breathes' is transliterated (not translated)",
    "8. Navigate to different pages and verify dynamic content is translated",
    "9. Check localStorage.getItem('lang') to verify language persistence"
  ],
